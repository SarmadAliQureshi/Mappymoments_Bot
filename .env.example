# Copy to .env.local and fill in your key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides
# GEMINI_TEXT_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Map tile providers. Styles whose key is missing are hidden.
NEXT_PUBLIC_THUNDERFOREST_KEY=
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_JAWG_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Set on any public deployment: everyone is asked for this password.
# Any user name works.
SITE_PASSWORD=

# Where the Ad Studio library is saved (default ./data).
# DATA_DIR=
